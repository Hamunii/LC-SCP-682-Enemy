# Ignore everything on root level
/*

# Ignore always
*.csproj.user
*.user.props
bin/
obj/

# Add source files
!/src/
!/tests/

# Config files
!/.config/
/.config/*
!/.config/dotnet-tools.json

!/.github/

# Add root level files
!/.csharpierignore
!/.editorconfig
!/.gitignore
!/CHANGELOG.md
!/Config.Build.user.props.template
!/CONTRIBUTING.md
!/Directory.Build.props
!/Directory.Build.targets
!/global.json
!/icon.png
!/LICENSE*
!/README.md
!/Plugin.slnx
