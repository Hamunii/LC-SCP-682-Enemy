<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This is the most appropriate target framework for the game's Unity version. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- This is the global identifier for your mod. This should not be changed after release. -->
    <AssemblyName>ProjectSCP.SCP682</AssemblyName>
    <!-- This is the display name of your mod. -->
    <AssemblyTitle>SCP682</AssemblyTitle>
    <!-- Package name on Thunderstore. Must not contain spaces ' ' or dashes '-'. -->
    <ThunderstoreName>SCP682</ThunderstoreName>
    <ThunderstoreDescription>Adds SCP-682, the hard-to-destroy reptile, as a monster to Lethal Company!</ThunderstoreDescription>
    <!--
        Communities and package categories metadata for publishing with ThunderPipe.
        Communities: https://thunderstore.io/api/experimental/community/
        Categories: https://thunderstore.io/api/experimental/community/lethal-company/category/
    -->
    <ThunderstoreCommunities>lethal-company</ThunderstoreCommunities>
    <ThunderstoreCategories>clientside;serverside;monsters;mods</ThunderstoreCategories>
    <!-- Whether or not this project should build a Thunderstore package. -->
    <IsThunderstorePackable>true</IsThunderstorePackable>
  </PropertyGroup>

  <Target
    Name="NetcodePatch"
    AfterTargets="Build"
    BeforeTargets="ThunderPipePack"
    Condition="$(Configuration) == 'Release'"
  >
    <Exec Command="dotnet netcode-patch -uv 2022.3.62 -nv 1.12.2 -tv 1.0.0 &quot;$(TargetPath)&quot; @(ReferencePathWithRefAssemblies->'&quot;%(Identity)&quot;', ' ')" />
  </Target>

  <!--
    Define mod files to copy to the relative BepInEx directory after build
    and where they are packed to when building a Thunderstore package
  -->
  <ItemGroup>
    <!-- TargetPath is the dll file produced during build. -->
    <ThunderstoreFile Include="$(TargetPath)" Destination="scripts/plugins/" />
    <ThunderstoreFile
      Include="$(ArtifactsPath)/bin/SCP682.UnityRef/$(ArtifactsPivots)/ProjectSCP.SCP682.UnityRef.dll"
      Destination="scripts/plugins/SCP682Assets/"
    />
    <!-- Make sure you have built the asset bundle at least once! -->
    <ThunderstoreFile
      Include="$(SolutionRoot)../UnityProject/AssetBundles/scp682assets"
      Destination="scripts/plugins/SCP682Assets/"
    />
    <ThunderstoreFile
      Include="$(SolutionRoot)../ExternalAssets/SCP682VideoBundle/scp682videobundle"
      Destination="scripts/plugins/SCP682Assets/"
    />
  </ItemGroup>

  <!-- Thunderstore package metadata -->
  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />

    <!--
      A list of Thunderstore packages this package requires at runtime.
      Note: This does NOT mark these as dependencies for this C# project;
            that must be done separately with PackageReference items.
    -->
    <ThunderstoreDependency Include="BepInEx-BepInExPack" Version="5.4.2305" />
    <ThunderstoreDependency Include="Evaisa-LethalLib" Version="1.2.0" />
    <ThunderstoreDependency Include="MonoDetour-MonoDetour_BepInEx_5" Version="0.7.13" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Evaisa.LethalLib" Version="1.2.0" />
    <PackageReference Include="MonoDetour" Version="[*,2.0)" />
    <PackageReference Include="MonoDetour.HookGen" Version="0.7.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionRoot)SCP682.UnityRef/SCP682.UnityRef.csproj" />
  </ItemGroup>

  <!--
    To reference mod assemblies from Thunderstore packages via NuGet,
    this project includes the following NuGet feed:
    https://nuget.windows10ce.com/nuget/v3/index.json

    With this, you can simply depend on a Thunderstore package like so:

    <ItemGroup>
      <PackageReference Include="ModTeam-ModName" Version="*" />
    </ItemGroup>

    This will cause the mod to be downloaded and its
    methods will be available at compile time for your code.

    Note that this does NOT mark the package as a dependency
    for your Thunderstore package.
  -->
</Project>
